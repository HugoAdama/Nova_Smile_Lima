---
import type { IconName } from '../../types';

interface Props {
  name: IconName;
  size?: number | string;
  class?: string;
  ariaLabel?: string;
}

const { name, size = 24, class: className = '', ariaLabel } = Astro.props;
const dimension = typeof size === 'number' ? `${size}px` : size;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={dimension}
  height={dimension}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['icon', `icon-${name}`, className]}
  aria-hidden={ariaLabel ? 'false' : 'true'}
  aria-label={ariaLabel}
  role={ariaLabel ? 'img' : 'presentation'}
>
  {name === 'check' && (
    <path d="M5 12.5l4.5 4.5L19 7.5" />
  )}

  {name === 'x' && (
    <g>
      <path d="M18 6L6 18" />
      <path d="M6 6l12 12" />
    </g>
  )}

  {name === 'cube' && (
    <g>
      <path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z" />
      <path d="M12 12l8-4.5" />
      <path d="M12 12L4 7.5" />
      <path d="M12 12v9" />
    </g>
  )}

  {name === 'shield' && (
    <g>
      <path d="M12 3l7 3v5.5c0 4.3-3 8-7 9.5-4-1.5-7-5.2-7-9.5V6l7-3z" />
      <path d="M9 12l2.2 2.2L15.5 10" />
    </g>
  )}

  {name === 'medal' && (
    <g>
      <circle cx="12" cy="9" r="5.5" />
      <path d="M8.5 13.5L7 21l5-3 5 3-1.5-7.5" />
    </g>
  )}

  {name === 'tooth' && (
    <path d="M7 3.5c-2.3 0-4 1.8-4 4.4 0 2 .8 3.3 1.4 5.1.7 2.1.7 7 2.6 7 1.6 0 1.4-3.6 2.3-5 .5-.8 1-1.1 1.7-1.1s1.2.3 1.7 1.1c.9 1.4.7 5 2.3 5 1.9 0 1.9-4.9 2.6-7 .6-1.8 1.4-3.1 1.4-5.1 0-2.6-1.7-4.4-4-4.4-1.8 0-2.7.9-4 .9S8.8 3.5 7 3.5z" />
  )}

  {name === 'sparkle' && (
    <path
      d="M12 2c.6 5.2 2.8 7.4 8 8-5.2.6-7.4 2.8-8 8-.6-5.2-2.8-7.4-8-8 5.2-.6 7.4-2.8 8-8z"
      fill="currentColor"
      stroke="none"
    />
  )}

  {name === 'implant' && (
    <g>
      <path d="M8 3h8l-1 5H9L8 3z" />
      <path d="M9 8h6" />
      <path d="M9.5 11.5h5" />
      <path d="M10 15h4" />
      <path d="M10.5 18.5h3L12 21l-1.5-2.5z" />
    </g>
  )}

  {name === 'aligner' && (
    <g>
      <path d="M3 14c0-4 3-7 9-7s9 3 9 7v1H3v-1z" />
      <path d="M6 15v2m4-2v3m4-3v3m4-3v2" />
    </g>
  )}

  {name === 'glow' && (
    <g>
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v3m0 14v3M2 12h3m14 0h3M4.93 4.93l2.12 2.12m9.9 9.9l2.12 2.12M4.93 19.07l2.12-2.12m9.9-9.9l2.12-2.12" />
    </g>
  )}

  {name === 'smile' && (
    <g>
      <circle cx="12" cy="12" r="9" />
      <path d="M8 14c1.2 2 2.6 2.6 4 2.6s2.8-.6 4-2.6" />
      <line x1="9" y1="9.5" x2="9.01" y2="9.5" stroke-width="2.5" />
      <line x1="15" y1="9.5" x2="15.01" y2="9.5" stroke-width="2.5" />
    </g>
  )}

  {name === 'pin' && (
    <g>
      <path d="M12 21s7-6.1 7-11.5A7 7 0 005 9.5C5 14.9 12 21 12 21z" />
      <circle cx="12" cy="9.5" r="2.5" />
    </g>
  )}

  {name === 'clock' && (
    <g>
      <circle cx="12" cy="12" r="9" />
      <polyline points="12 6 12 12 16 14" />
    </g>
  )}

  {name === 'phone' && (
    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
  )}

  {name === 'person' && (
    <g>
      <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
      <circle cx="12" cy="7" r="4" />
    </g>
  )}

  {name === 'whatsapp' && (
    <path
      d="M17.5 14.5c-.3-.2-1.8-.9-2.1-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1s-1.3-.5-2.5-1.5c-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.7l.5-.6c.2-.2.2-.4.1-.6s-.7-1.7-1-2.3c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4s-1.2 1.2-1.2 2.8 1.2 3.3 1.4 3.5c.2.2 2.4 3.7 5.9 5.2 2.9 1.2 3.5 1 4.2.9.7-.1 2.1-.8 2.4-1.7.3-.8.3-1.6.2-1.7-.1-.2-.3-.3-.6-.4zM12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2z"
      fill="currentColor"
      stroke="none"
    />
  )}

  {name === 'arrow-left' && (
    <path d="M19 12H5M12 19l-7-7 7-7" />
  )}

  {name === 'arrow-right' && (
    <path d="M5 12h14M12 5l7 7-7 7" />
  )}

  {name === 'star' && (
    <polygon
      points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
      fill="currentColor"
    />
  )}

  {name === 'lock' && (
    <g>
      <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
      <path d="M7 11V7a5 5 0 0 1 10 0v4" />
    </g>
  )}

  {name === 'calendar' && (
    <g>
      <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
      <line x1="16" y1="2" x2="16" y2="6" />
      <line x1="8" y1="2" x2="8" y2="6" />
      <line x1="3" y1="10" x2="21" y2="10" />
    </g>
  )}

  {name === 'chat' && (
    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
  )}

  {name === 'document' && (
    <g>
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
      <polyline points="14 2 14 8 20 8" />
      <line x1="16" y1="13" x2="8" y2="13" />
      <line x1="16" y1="17" x2="8" y2="17" />
      <polyline points="10 9 9 9 8 9" />
    </g>
  )}

  {name === 'sparkles' && (
    <g>
      <path d="M12 3l1.9 4.1L18 9l-4.1 1.9L12 15l-1.9-4.1L6 9l4.1-1.9L12 3z" fill="currentColor" stroke="none" />
      <path d="M19 15l.9 2.1L22 18l-2.1.9L19 21l-.9-2.1L16 18l2.1-.9L19 15z" fill="currentColor" stroke="none" />
      <path d="M5 16l.9 2.1L8 19l-2.1.9L5 22l-.9-2.1L2 19l2.1-.9L5 16z" fill="currentColor" stroke="none" />
    </g>
  )}

  {name === 'chevron-down' && (
    <polyline points="6 9 12 15 18 9" />
  )}

  {name === 'camera' && (
    <g>
      <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
      <circle cx="12" cy="13" r="4" />
    </g>
  )}

  {name === 'heart' && (
    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
  )}

  {name === 'stethoscope' && (
    <path d="M4.5 3v5a4.5 4.5 0 0 0 9 0V3M8 12.5v3.5a4 4 0 0 0 8 0v-1a2.5 2.5 0 0 1 5 0v1a6.5 6.5 0 0 1-13 0" />
  )}

  {name === 'instagram' && (
    <g>
      <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
      <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
      <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" stroke-width="2.5" />
    </g>
  )}

  {name === 'linkedin' && (
    <g>
      <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
      <rect x="2" y="9" width="4" height="12" />
      <circle cx="4" cy="4" r="2" />
    </g>
  )}

  {name === 'facebook' && (
    <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
  )}

  {name === 'book' && (
    <g>
      <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
      <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
    </g>
  )}
</svg>

<style>
  .icon {
    display: inline-block;
    vertical-align: middle;
    flex-shrink: 0;
  }
</style>
