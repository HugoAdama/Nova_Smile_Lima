---
import Icon from '../common/Icon.astro';
import SectionHeader from '../common/SectionHeader.astro';
import { processSteps } from '../../data/process';
---

<section class="seccion" id="proceso" aria-labelledby="proceso-titulo">
  <div class="contenedor">
    <div class="reveal">
      <SectionHeader
        kicker="Metodología Serene Flow"
        title="Cuatro pasos, sin enredos"
        description="Sabrás exactamente qué esperar, los tiempos estimados y el costo cerrado en cada etapa antes de que ocurra."
      />
    </div>

    <ol class="pasos reveal-stagger reveal">
      {processSteps.map((paso) => (
        <li class="paso">
          <div class="paso__numero" aria-hidden="true">{paso.number}</div>
          <div class="paso__icono-wrap">
            <Icon name={paso.icon} size={22} class="paso__icono" />
          </div>
          <h3>{paso.title}</h3>
          <p class="paso__desc">{paso.description}</p>
          <div class="paso__detalle">
            <span>{paso.details}</span>
          </div>
        </li>
      ))}
    </ol>

    <div class="proceso__cta reveal" style="transition-delay: 0.25s;">
      <div class="proceso__cta-aviso">
        <Icon name="shield" size={20} class="icono-oro" />
        <p>Garantía de transparencia: nunca se iniciará un procedimiento sin tu consentimiento firmado y presupuesto aceptado.</p>
      </div>
      <a class="btn btn--oro" href="#agenda">
        <Icon name="calendar" size={18} />
        <span>Empieza tu plan hoy</span>
      </a>
    </div>
  </div>
</section>

<style>
  .pasos {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.8rem;
    position: relative;
    margin-top: 1.8rem;
  }

  .paso {
    position: relative;
    background: #FFFFFF;
    border: 1px solid var(--piedra);
    border-radius: var(--radio-lg);
    padding: 2.4rem 1.6rem 1.8rem;
    display: flex;
    flex-direction: column;
    box-shadow: var(--sombra-sm);
    transition: transform var(--trans-media),
                box-shadow var(--trans-media),
                border-color var(--trans-media);
  }

  .paso:hover {
    transform: translateY(-6px);
    box-shadow: var(--sombra-lg), 0 0 20px rgba(198, 161, 91, 0.15);
    border-color: rgba(198, 161, 91, 0.45);
  }

  .paso__numero {
    position: absolute;
    top: -20px;
    left: 20px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--azul);
    color: var(--oro);
    display: grid;
    place-items: center;
    font-family: var(--f-titulo);
    font-size: 1.5rem;
    font-weight: 700;
    box-shadow: 0 6px 16px rgba(10, 37, 64, 0.28);
    border: 2px solid var(--marfil);
    transition: transform var(--trans-rapida), background-color var(--trans-rapida), color var(--trans-rapida), box-shadow var(--trans-rapida);
  }

  .paso:hover .paso__numero {
    transform: scale(1.15) rotate(-5deg);
    background: var(--oro);
    color: var(--azul);
    box-shadow: 0 0 16px rgba(198, 161, 91, 0.6);
  }

  .paso__icono-wrap {
    margin-top: 0.5rem;
    margin-bottom: 1.1rem;
    width: 38px;
    height: 38px;
    border-radius: var(--radio-sm);
    background: var(--marfil-fuerte);
    display: grid;
    place-items: center;
    transition: background-color var(--trans-rapida), transform var(--trans-rapida);
  }

  .paso:hover .paso__icono-wrap {
    background: rgba(198, 161, 91, 0.2);
    transform: scale(1.08);
  }

  .paso__icono {
    color: var(--azul);
  }

  .paso h3 {
    font-size: 1.35rem;
    margin-bottom: 0.6rem;
    line-height: 1.25;
  }

  .paso__desc {
    color: var(--texto-suave);
    font-size: 0.92rem;
    line-height: 1.55;
    margin-bottom: 1rem;
    flex-grow: 1;
  }

  .paso__detalle {
    padding-top: 0.85rem;
    border-top: 1px dashed var(--piedra);
    font-size: 0.82rem;
    color: #6C7A89;
    line-height: 1.45;
  }

  .proceso__cta {
    margin-top: 3.5rem;
    padding: 1.8rem 2.2rem;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(8px);
    border: 1px solid var(--piedra);
    border-radius: var(--radio-lg);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    box-shadow: var(--sombra-sm);
    transition: transform var(--trans-media), box-shadow var(--trans-media), border-color var(--trans-media);
  }

  .proceso__cta:hover {
    transform: translateY(-2px);
    border-color: rgba(198, 161, 91, 0.4);
    box-shadow: var(--sombra-md);
  }

  .proceso__cta-aviso {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .icono-oro {
    color: var(--oro);
    flex-shrink: 0;
  }

  .proceso__cta-aviso p {
    font-size: 0.95rem;
    color: var(--azul);
    margin: 0;
  }

  @media (max-width: 1024px) {
    .pasos {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 2.8rem;
    }
  }

  @media (max-width: 600px) {
    .pasos {
      grid-template-columns: 1fr;
      row-gap: 2.8rem;
    }
    .proceso__cta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
