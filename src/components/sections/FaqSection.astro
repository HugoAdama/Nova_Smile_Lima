---
import Icon from '../common/Icon.astro';
import SectionHeader from '../common/SectionHeader.astro';
import { faqs } from '../../data/faqs';
import { siteConfig } from '../../data/site';
---

<section class="seccion seccion--alterna" id="faq" aria-labelledby="faq-titulo">
  <div class="contenedor">
    <div class="reveal">
      <SectionHeader
        kicker="Claridad & Transparencia"
        title="Preguntas frecuentes"
        description="Resolvemos tus inquietudes sobre dolor, presupuestos, tiempos y cobertura de seguros antes de tu primera consulta."
      />
    </div>

    <div class="faq-contenedor">
      <div class="faq-lista reveal-stagger reveal">
        {faqs.map((f, index) => (
          <details class="faq-item" open={index === 0}>
            <summary class="faq-summary">
              <span class="faq-pregunta">{f.question}</span>
              <span class="faq-toggle-icon" aria-hidden="true">
                <Icon name="chevron-down" size={18} />
              </span>
            </summary>
            <div class="faq-respuesta">
              <p>{f.answer}</p>
            </div>
          </details>
        ))}
      </div>

      <div class="faq__sidebar reveal" style="transition-delay: 0.2s;">
        <div class="faq__card">
          <div class="faq__card-icono">
            <Icon name="chat" size={26} />
          </div>
          <h3>¿Tienes una pregunta específica sobre tu caso?</h3>
          <p>
            Nuestro equipo de recepción y orientación odontológica atiende consultas de lunes a sábado en San Isidro.
          </p>
          <a
            class="btn btn--oro btn--bloque"
            href={`https://wa.me/${siteConfig.contact.whatsappClean}?text=Hola,%20tengo%20una%20consulta%20previa%20sobre%20los%20tratamientos`}
            target="_blank"
            rel="noopener"
          >
            <Icon name="whatsapp" size={18} />
            <span>Consultar por WhatsApp</span>
          </a>
          <div class="faq__card-tiempo">
            <Icon name="clock" size={14} />
            <span>Tiempo promedio de respuesta: menor a 15 minutos</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .faq-contenedor {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
  }

  .faq-lista {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-item {
    background: #FFFFFF;
    border: 1px solid var(--piedra);
    border-radius: var(--radio-md);
    overflow: hidden;
    box-shadow: var(--sombra-sm);
    transition: border-color var(--trans-media),
                box-shadow var(--trans-media),
                transform var(--trans-media);
  }

  .faq-item:hover {
    border-color: rgba(198, 161, 91, 0.45);
    box-shadow: var(--sombra-md);
  }

  .faq-item[open] {
    border-color: rgba(198, 161, 91, 0.6);
    box-shadow: var(--sombra-md), 0 0 16px rgba(198, 161, 91, 0.12);
  }

  .faq-summary {
    list-style: none;
    cursor: pointer;
    padding: 1.35rem 1.6rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-family: var(--f-titulo);
    font-size: 1.45rem;
    font-weight: 600;
    color: var(--azul);
    user-select: none;
    transition: color var(--trans-rapida);
  }

  .faq-summary:hover {
    color: var(--azul-suave);
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-toggle-icon {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1.5px solid var(--oro);
    display: grid;
    place-items: center;
    color: var(--azul);
    flex-shrink: 0;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                background-color 0.35s ease,
                color 0.35s ease;
  }

  .faq-item[open] .faq-toggle-icon {
    transform: rotate(180deg);
    background-color: var(--oro);
    color: var(--azul);
    box-shadow: 0 0 12px rgba(198, 161, 91, 0.5);
  }

  .faq-respuesta {
    padding: 0 1.6rem 1.6rem;
    animation: fadeInFaq 0.35s ease-out;
  }

  @keyframes fadeInFaq {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .faq-respuesta p {
    color: var(--texto-suave);
    font-size: 0.98rem;
    line-height: 1.65;
    margin: 0;
  }

  .faq__card {
    background: #FFFFFF;
    border: 1px solid var(--piedra);
    border-radius: var(--radio-lg);
    padding: clamp(2rem, 3.8vw, 2.8rem);
    box-shadow: var(--sombra-md);
    transition: transform var(--trans-media), box-shadow var(--trans-media), border-color var(--trans-media);
  }

  .faq__card:hover {
    transform: translateY(-4px);
    border-color: rgba(198, 161, 91, 0.45);
    box-shadow: var(--sombra-lg);
  }

  .faq__card-icono {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--azul);
    color: var(--oro);
    display: grid;
    place-items: center;
    margin-bottom: 1.4rem;
    transition: transform var(--trans-rapida), box-shadow var(--trans-rapida);
  }

  .faq__card:hover .faq__card-icono {
    transform: scale(1.08) rotate(5deg);
    box-shadow: 0 8px 20px rgba(10, 37, 64, 0.3);
  }

  .faq__card h3 {
    font-size: 1.55rem;
    margin-bottom: 0.8rem;
    line-height: 1.25;
  }

  .faq__card p {
    color: var(--texto-suave);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.6rem;
  }

  .faq__card-tiempo {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8rem;
    color: #7D8895;
    margin-top: 1.1rem;
    justify-content: center;
  }

  @media (max-width: 960px) {
    .faq-contenedor {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .faq-summary {
      font-size: 1.25rem;
      padding: 1.1rem 1.2rem;
    }
    .faq-respuesta {
      padding: 0 1.2rem 1.2rem;
    }
  }
</style>
