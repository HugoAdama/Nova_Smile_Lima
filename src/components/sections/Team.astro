---
import Icon from '../common/Icon.astro';
import SectionHeader from '../common/SectionHeader.astro';
import { specialists } from '../../data/team';
---

<section class="seccion seccion--alterna" id="equipo" aria-labelledby="equipo-titulo">
  <div class="contenedor">
    <div class="reveal">
      <SectionHeader
        kicker="Cuerpo Médico Colegiado"
        title="Especialistas que escuchan antes de tratar"
        description="Cirujanos dentistas y rehabilitadores colegiados con dedicación exclusiva, formación de postgrado y un compromiso irrenunciable con la odontología mínimamente invasiva."
      />
    </div>

    <div class="equipo reveal-stagger reveal">
      {specialists.map((doc) => (
        <article class="persona">
          <div class="persona__foto-marco">
            <img
              src={doc.photo}
              alt={`Fotografía profesional de ${doc.name}, ${doc.role}`}
              width="600"
              height="750"
              loading="lazy"
              decoding="async"
              class="persona__foto"
            />
            <div class="persona__colegiatura-chip">
              <Icon name="medal" size={14} />
              <span>{doc.cop}</span>
              {doc.rne && <span class="persona__rne">· {doc.rne}</span>}
            </div>
          </div>

          <div class="persona__info">
            <h3>{doc.name}</h3>
            <p class="persona__rol">{doc.role}</p>
            <p class="persona__bio">{doc.bio}</p>

            <div class="persona__especialidades">
              {doc.specialties.map((esp) => (
                <span class="persona__tag">{esp}</span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="equipo__cta reveal" style="transition-delay: 0.25s;">
      <div class="equipo__cta-texto">
        <Icon name="stethoscope" size={24} class="icono-oro" />
        <p>Todos nuestros profesionales están habilitados activamente por el Colegio Odontológico del Perú (COP).</p>
      </div>
      <a class="btn btn--linea" href="#agenda">
        <span>Coordinar cita con un especialista</span>
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
  </div>
</section>

<style>
  .equipo {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .persona {
    background: #FFFFFF;
    border-radius: var(--radio-lg);
    border: 1px solid var(--piedra);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--sombra-sm);
    transition: transform var(--trans-media),
                box-shadow var(--trans-media),
                border-color var(--trans-media);
  }

  .persona:hover {
    transform: translateY(-6px);
    box-shadow: var(--sombra-lg), 0 0 25px rgba(198, 161, 91, 0.15);
    border-color: rgba(198, 161, 91, 0.4);
  }

  .persona__foto-marco {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--marfil-fuerte);
    overflow: hidden;
  }

  .persona__foto {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .persona:hover .persona__foto {
    transform: scale(1.05);
  }

  .persona__colegiatura-chip {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    background: rgba(10, 37, 64, 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: var(--oro);
    font-family: var(--f-acento);
    font-size: 0.76rem;
    font-weight: 600;
    padding: 0.5rem 0.95rem;
    border-radius: var(--radio-pill);
    display: flex;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid rgba(198, 161, 91, 0.4);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
    transition: background-color var(--trans-rapida), border-color var(--trans-rapida);
  }

  .persona:hover .persona__colegiatura-chip {
    background: rgba(10, 37, 64, 0.98);
    border-color: var(--oro);
  }

  .persona__rne {
    color: #D3DEEB;
    font-size: 0.72rem;
  }

  .persona__info {
    padding: clamp(1.4rem, 2.5vw, 1.8rem);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .persona h3 {
    font-size: 1.45rem;
    margin: 0 0 0.35rem;
    transition: color var(--trans-rapida);
  }

  .persona:hover h3 {
    color: var(--azul-suave);
  }

  .persona__rol {
    font-family: var(--f-acento);
    font-size: 0.85rem;
    color: var(--azul-suave);
    font-weight: 600;
    margin-bottom: 0.8rem;
  }

  .persona__bio {
    color: var(--texto-suave);
    font-size: 0.9rem;
    line-height: 1.55;
    margin-bottom: 1.25rem;
  }

  .persona__especialidades {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--piedra);
  }

  .persona__tag {
    font-size: 0.74rem;
    font-family: var(--f-acento);
    font-weight: 500;
    color: var(--azul);
    background: var(--marfil-fuerte);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radio-sm);
    transition: background-color var(--trans-rapida), color var(--trans-rapida);
  }

  .persona:hover .persona__tag {
    background: rgba(198, 161, 91, 0.15);
    color: #7A5F27;
  }

  .equipo__cta {
    margin-top: 3.5rem;
    padding: 1.8rem 2.2rem;
    background: #FFFFFF;
    border: 1px solid var(--piedra);
    border-radius: var(--radio-lg);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    box-shadow: var(--sombra-sm);
    transition: transform var(--trans-media), box-shadow var(--trans-media), border-color var(--trans-media);
  }

  .equipo__cta:hover {
    transform: translateY(-2px);
    border-color: rgba(198, 161, 91, 0.4);
    box-shadow: var(--sombra-md);
  }

  .equipo__cta-texto {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .icono-oro {
    color: var(--oro);
    flex-shrink: 0;
  }

  .equipo__cta-texto p {
    font-size: 0.95rem;
    color: var(--azul);
    margin: 0;
    font-weight: 500;
  }

  @media (max-width: 960px) {
    .equipo {
      grid-template-columns: 1fr;
      max-width: 480px;
      margin-inline: auto;
    }
    .equipo__cta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
