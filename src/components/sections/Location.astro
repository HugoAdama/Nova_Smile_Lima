---
import Icon from '../common/Icon.astro';
import SectionHeader from '../common/SectionHeader.astro';
import { siteConfig } from '../../data/site';
---

<section class="seccion ubicacion" id="ubicacion" aria-labelledby="ubicacion-titulo">
  <div class="contenedor">
    <div class="reveal">
      <SectionHeader
        kicker="Ubicación Privilegiada"
        title="San Isidro, Lima: un refugio de calma dental"
        description="Nuestra sede boutique está diseñada con luz natural, aislación acústica y estacionamiento privado para que tu visita sea un paréntesis de tranquilidad."
      />
    </div>

    <div class="ubicacion__rejilla">
      <div class="ubicacion__info reveal">
        <div class="datos reveal-stagger reveal">
          <div class="dato">
            <div class="dato__icono-wrap">
              <Icon name="pin" size={24} class="dato__icono" />
            </div>
            <div>
              <strong>Dirección en San Isidro</strong>
              <span>{siteConfig.address.street}</span>
              <span class="dato__referencia">{siteConfig.address.reference}</span>
            </div>
          </div>

          <div class="dato">
            <div class="dato__icono-wrap">
              <Icon name="clock" size={24} class="dato__icono" />
            </div>
            <div>
              <strong>Horarios de atención</strong>
              <span>{siteConfig.schedule.weekdays}</span>
              <span>{siteConfig.schedule.saturdays}</span>
            </div>
          </div>

          <div class="dato">
            <div class="dato__icono-wrap">
              <Icon name="phone" size={24} class="dato__icono" />
            </div>
            <div>
              <strong>Contacto directo</strong>
              <span>Teléfono: {siteConfig.contact.phone}</span>
              <span>WhatsApp: {siteConfig.contact.whatsapp}</span>
            </div>
          </div>
        </div>

        <div class="ubicacion__acciones reveal" style="transition-delay: 0.25s;">
          <a
            class="btn btn--oro"
            href={siteConfig.address.googleMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="pin" size={18} />
            <span>Ver cómo llegar en Google Maps</span>
          </a>
        </div>
      </div>

      <div class="ubicacion__visual reveal" style="transition-delay: 0.2s;">
        <div class="ubicacion__foto-wrap">
          <img
            src="/images/lounge-reception.jpg"
            alt="Recepción y sala de espera boutique de Nova Smile Lima en San Isidro"
            width="800"
            height="500"
            loading="lazy"
            decoding="async"
            class="ubicacion__foto"
          />
          <div class="ubicacion__chip">
            <Icon name="sparkles" size={16} />
            <span>Recepción y Lounge Boutique en San Isidro</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ubicacion__rejilla {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  .datos {
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
  }

  .dato {
    display: flex;
    align-items: flex-start;
    gap: 1.2rem;
    padding: 0.8rem 1rem;
    border-radius: var(--radio-md);
    transition: background-color var(--trans-rapida), transform var(--trans-rapida);
  }

  .dato:hover {
    background: rgba(255, 255, 255, 0.6);
    transform: translateX(4px);
  }

  .dato__icono-wrap {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: var(--marfil-fuerte);
    display: grid;
    place-items: center;
    flex-shrink: 0;
    transition: background-color var(--trans-rapida), transform var(--trans-rapida);
  }

  .dato:hover .dato__icono-wrap {
    background: var(--azul);
    transform: scale(1.08) rotate(5deg);
  }

  .dato__icono {
    color: var(--azul);
    transition: color var(--trans-rapida);
  }

  .dato:hover .dato__icono {
    color: var(--oro);
  }

  .dato strong {
    display: block;
    font-family: var(--f-acento);
    font-size: 1.02rem;
    color: var(--azul);
    margin-bottom: 0.25rem;
  }

  .dato span {
    display: block;
    color: var(--texto-suave);
    font-size: 0.94rem;
    line-height: 1.5;
  }

  .dato__referencia {
    font-size: 0.84rem;
    color: #7B8896;
    margin-top: 0.15rem;
  }

  .ubicacion__acciones {
    margin-top: 2.5rem;
  }

  .ubicacion__foto-wrap {
    position: relative;
    border-radius: var(--radio-lg);
    overflow: hidden;
    box-shadow: var(--sombra-lg);
    border: 1px solid var(--piedra);
    aspect-ratio: 16 / 10;
    transition: transform var(--trans-media), box-shadow var(--trans-media);
  }

  .ubicacion__foto-wrap:hover {
    transform: translateY(-4px);
    box-shadow: 0 30px 65px -15px rgba(10, 37, 64, 0.25);
  }

  .ubicacion__foto {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ubicacion__foto-wrap:hover .ubicacion__foto {
    transform: scale(1.04);
  }

  .ubicacion__chip {
    position: absolute;
    bottom: 1.25rem;
    left: 1.25rem;
    background: rgba(10, 37, 64, 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: var(--oro);
    font-size: 0.82rem;
    font-family: var(--f-acento);
    font-weight: 600;
    padding: 0.55rem 1.05rem;
    border-radius: var(--radio-pill);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid rgba(198, 161, 91, 0.4);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    animation: floatGentle 6s ease-in-out infinite;
  }

  @media (max-width: 960px) {
    .ubicacion__rejilla {
      grid-template-columns: 1fr;
    }
  }
</style>
