---
import Logo from '../common/Logo.astro';
import { mainNavLinks } from '../../data/navigation';
---

<header class="header" id="cabecera-principal">
  <div class="contenedor header__fila">
    <Logo />

    <input type="checkbox" id="menu-toggle" class="sr-only-input" aria-label="Abrir menú de navegación" />
    <label for="menu-toggle" class="burger" aria-hidden="true" title="Menú">
      <span></span>
      <span></span>
      <span></span>
    </label>

    <nav class="nav" aria-label="Navegación principal">
      <ul>
        {mainNavLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header__acciones">
      <a class="btn btn--oro header__cta" href="/#agenda">
        Reserva tu evaluación
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('cabecera-principal');
  if (header) {
    const handleScroll = () => {
      if (window.scrollY > 30) {
        header.classList.add('header--scrolled');
      } else {
        header.classList.remove('header--scrolled');
      }
    };
    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--header-h);
    background: rgba(247, 243, 236, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--piedra);
    transition: background-color 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .header.header--scrolled {
    background: rgba(247, 243, 236, 0.98);
    box-shadow: 0 4px 24px -4px rgba(10, 37, 64, 0.1);
    border-color: rgba(198, 161, 91, 0.25);
  }

  .header__fila {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .nav ul {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .nav a {
    font-family: var(--f-acento);
    font-weight: 500;
    font-size: 0.96rem;
    color: var(--azul);
    position: relative;
    padding-block: 0.4rem;
    transition: color var(--trans-rapida);
  }

  .nav a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 2px;
    background-color: var(--turquesa);
    transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav a:hover {
    color: var(--azul-suave);
  }

  .nav a:hover::after {
    width: 100%;
  }

  .header__cta {
    padding: 0.75rem 1.4rem;
    font-size: 0.94rem;
  }

  .sr-only-input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .burger {
    display: none;
    width: 44px;
    height: 44px;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 6px;
    border-radius: var(--radio-sm);
  }

  .burger span {
    width: 24px;
    height: 2px;
    background-color: var(--azul);
    transition: transform var(--trans-rapida), opacity var(--trans-rapida);
  }

  .sr-only-input:focus-visible + .burger {
    outline: 3px solid var(--turquesa);
  }

  @media (max-width: 960px) {
    .burger {
      display: flex;
    }

    .header__acciones {
      display: none;
    }

    .nav {
      position: absolute;
      top: var(--header-h);
      left: 0;
      right: 0;
      background: var(--marfil);
      border-bottom: 1px solid var(--piedra);
      padding: 0 1.25rem;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: var(--sombra-lg);
    }

    .nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-block: 0.5rem 1.5rem;
    }

    .nav li {
      border-top: 1px solid rgba(217, 214, 208, 0.6);
    }

    .nav li:first-child {
      border-top: none;
    }

    .nav a {
      display: block;
      padding: 0.9rem 0;
      font-size: 1rem;
    }

    .nav a::after {
      display: none;
    }

    .sr-only-input:checked ~ .nav {
      max-height: 480px;
    }

    .sr-only-input:checked ~ .burger span:nth-child(1) {
      transform: translateY(8px) rotate(45deg);
    }

    .sr-only-input:checked ~ .burger span:nth-child(2) {
      opacity: 0;
    }

    .sr-only-input:checked ~ .burger span:nth-child(3) {
      transform: translateY(-8px) rotate(-45deg);
    }
  }
</style>
