---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/common/Icon.astro';
import SectionHeader from '../../components/common/SectionHeader.astro';
import { blogPosts } from '../../data/blog';
import { getAssetPath } from '../../utils/path';
---

<Layout
  title="Blog Dental & Educación Clínica | Nova Smile Lima"
  description="Artículos educativos sobre estética dental biomimética, ortodoncia invisible y tecnología 3D por especialistas de Nova Smile Lima."
>
  <div class="blog-page">
    <header class="blog-hero">
      <div class="contenedor">
        <a href={getAssetPath('/')} class="blog-hero__volver">
          <Icon name="arrow-left" size={16} />
          <span>Volver al inicio</span>
        </a>

        <span class="kicker">Educación & Salud Dental</span>
        <h1>Conocimiento y salud para tu sonrisa</h1>
        <p class="blog-hero__lead">
          Información clínica basada en evidencia, redactada por odontólogos colegiados en San Isidro para que tomes decisiones informadas sobre tu salud bucal.
        </p>
      </div>
    </header>

    <section class="seccion">
      <div class="contenedor">
        <div class="blog-rejilla">
          {blogPosts.map((post) => (
            <article class="articulo-card">
              <div class="articulo-card__header">
                <span class="articulo-categoria">{post.category}</span>
                <span class="articulo-lectura">
                  <Icon name="clock" size={14} />
                  <span>{post.readTime}</span>
                </span>
              </div>

              <h2>{post.title}</h2>
              <p class="articulo-excerpt">{post.excerpt}</p>

              <div class="articulo-footer">
                <div class="articulo-autor">
                  <Icon name="person" size={16} class="icono-oro" />
                  <span>{post.author}</span>
                </div>
                <span class="articulo-fecha">{post.date}</span>
              </div>

              <div class="articulo-accion">
                <a href="#agenda" class="enlace-flecha">
                  <span>Consultar sobre este tema con el especialista</span>
                  <Icon name="arrow-right" size={14} />
                </a>
              </div>
            </article>
          ))}
        </div>

        <div class="blog-cta-bloque">
          <div class="blog-cta-tarjeta">
            <div>
              <h3>¿Tienes dudas sobre un tratamiento en específico?</h3>
              <p>Agenda una evaluación 3D en San Isidro y nuestro equipo te explicará todas las opciones para tu caso.</p>
            </div>
            <a class="btn btn--oro" href={getAssetPath('/#agenda')}>
              <Icon name="calendar" size={18} />
              <span>Reserva tu evaluación</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .blog-hero {
    background: radial-gradient(circle at 10% 20%, rgba(198, 161, 91, 0.12), transparent 45%),
                var(--marfil-fuerte);
    padding-block: clamp(3rem, 6vw, 5rem);
    border-bottom: 1px solid var(--piedra);
  }

  .blog-hero__volver {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--f-acento);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--azul);
    margin-bottom: 1.5rem;
    text-decoration: underline;
  }

  .blog-hero h1 {
    font-size: clamp(2.4rem, 4.5vw, 3.8rem);
    max-width: 22ch;
    margin-bottom: 1rem;
  }

  .blog-hero__lead {
    font-size: 1.2rem;
    color: var(--texto-suave);
    max-width: 58ch;
    line-height: 1.6;
    margin: 0;
  }

  .blog-rejilla {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .articulo-card {
    background: #FFFFFF;
    border: 1px solid var(--piedra);
    border-radius: var(--radio-lg);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    box-shadow: var(--sombra-sm);
    transition: transform var(--trans-rapida), box-shadow var(--trans-rapida);
  }

  .articulo-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--sombra-lg);
  }

  .articulo-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.1rem;
  }

  .articulo-categoria {
    font-family: var(--f-acento);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--azul);
    background: var(--marfil-fuerte);
    padding: 0.3rem 0.7rem;
    border-radius: var(--radio-pill);
  }

  .articulo-lectura {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    color: var(--texto-suave);
    font-family: var(--f-acento);
  }

  .articulo-card h2 {
    font-size: 1.45rem;
    line-height: 1.3;
    margin: 0 0 0.8rem;
  }

  .articulo-excerpt {
    color: var(--texto-suave);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .articulo-footer {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding-block: 0.9rem;
    border-top: 1px solid var(--piedra);
    border-bottom: 1px solid var(--piedra);
    margin-bottom: 1.2rem;
    font-size: 0.82rem;
  }

  .articulo-autor {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 600;
    color: var(--azul);
  }

  .icono-oro {
    color: var(--oro);
  }

  .articulo-fecha {
    color: #7D8895;
  }

  .blog-cta-bloque {
    margin-top: 4rem;
  }

  .blog-cta-tarjeta {
    background: var(--azul);
    color: var(--marfil);
    border-radius: var(--radio-lg);
    padding: clamp(2rem, 4vw, 3rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .blog-cta-tarjeta h3 {
    color: var(--marfil);
    font-size: 1.8rem;
    margin-bottom: 0.5rem;
  }

  .blog-cta-tarjeta p {
    color: #C9D3DE;
    margin: 0;
  }

  @media (max-width: 960px) {
    .blog-rejilla {
      grid-template-columns: 1fr;
      max-width: 540px;
      margin-inline: auto;
    }
  }
</style>
